@using Entities.ViewModels.Tickets
@model TicketIndexVm

@{
    ViewData["Title"] = "Support Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Update layout if necessary
}

<style>
    body {
        background-color: #f5f7f8;
    }

    .primary-bg {
        background-color: #004a99 !important;
    }

    .primary-text {
        color: #004a99 !important;
    }

    .nav-tabs .nav-link.active {
        color: #004a99;
        font-weight: 600;
        border-color: #004a99 #004a99 #fff;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>

<div class="container-fluid py-4">
    <div class="container">

        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
            <div>
                <h2 class="fw-bold">Support Tickets</h2>
                <p class="text-muted mb-0">
                    Manage and track your enterprise support requests across all services.
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link active">All Tickets</button>
            </li>
            <li class="nav-item">
                <button class="nav-link">Open</button>
            </li>
            <li class="nav-item">
                <button class="nav-link">In Progress</button>
            </li>
            <li class="nav-item">
                <button class="nav-link">Resolved</button>
            </li>
        </ul>

        <!-- Table Card -->
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket ID</th>
                            <th>Service</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Assigned Agent</th>
                            <th>Last Update</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach(var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold primary-text">#@item.Code</td>
                                    <td>@(item.ServiceId)</td>
                                    <td>@item.Subject</td>
                                    <td>
                                        @if(item.Status == Entities.Models.TicketStatus.Open)
                                        {
                                            <span class="badge bg-primary">Open</span>
                                        }
                                        else if(item.Status == Entities.Models.TicketStatus.InProgress)
                                        {
                                            <span class="badge bg-warning text-dark">In Progress</span>
                                        }
                                        else 
                                        {
                                            <span class="badge bg-success">Resolved</span>
                                        }
                                    </td>
                                    <td>@item.AssignedAgentId</td>
                                    <td class="text-muted">@item.LastMessageAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a href="/Ticket/Detail/@item.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center">
                 @if (Model.Total > 0)
                {
                    <small class="text-muted">
                        Showing <strong>@((Model.Query.Page - 1) * Model.Query.PageSize + 1)</strong> to <strong>@(Math.Min(Model.Query.Page * Model.Query.PageSize, Model.Total))</strong> of <strong>@Model.Total</strong> results
                    </small>
                }
                else
                {
                    <small class="text-muted">No results found</small>
                }

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled">
                            <a class="page-link" href="#">«</a>
                        </li>
                        <li class="page-item active">
                            <a class="page-link primary-bg border-0" href="#">1</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">»</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
</div>
