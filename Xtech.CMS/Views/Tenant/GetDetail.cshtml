@{
    Layout = null;
}
@using Entities.Models
@using Entities.ViewModels
@using Entities.ViewModels.Department
@model TenantViewModel

<tr class="info-detail">
    <td colspan="7">
        <div class="tab-default">
            <a class="btn-panel-detail active" data-tab="1">Thông tin</a>
            <a class="btn-panel-detail" data-tab="2">Vai trò</a>
        </div>

        <div class="wrap">
            <div class="tab-content">
                <div class="tab-detail" data-id="1">
                    <div class="flex form-default">
                        <div class="name">
                            <h4>@Model.SurrogateName</h4>
                            <div class="status text-status-user">@(Model.Status == 0 ? "Đang hoạt động":"Tạm ngừng")</div>
                        </div>
                        <div class="info-form row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="lbl">
                                        <span class="col-4">Họ tên:</span>
                                        <span class="col-8">@Model.SurrogateName</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="lbl">
                                        <span class="col-4">Tên đăng nhập:</span>
                                        <span class="col-8">@Model.UserName</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="lbl">
                                        <span class="col-4">Điện thoại:</span>
                                        <span class="col-8">@Model.SurrogatePhone</span>
                                    </label>
                                </div>

                            
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="lbl">
                                        <span class="col-4">Email:</span>
                                        <span class="col-8">@Model.SurrogateEmail</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="lbl">
                                        <span class="col-4">Địa chỉ:</span>
                                        <span class="col-8">
                                            @Model.Address
                                        </span>
                                    </label>
                                </div>
                               
                            </div>
                        </div>
                        <div class="form-group align-right col-12 mt20 block">
                
                            <button type="submit" class="btn btn-default bg-main" onclick="_tenant.OnOpenEditForm('@Model.TenantId')">
                                <i class="fa fa-pencil-square-o"></i>Cập nhật
                            </button>
                          
                            <button type="button" class="btn btn-default btn-change-user-status red" data-id="@Model.TenantId">
                                <i class="fa fa-lock"></i><span> @(Model.Status == 0 ? "Khóa tài khoản": "Mở tài khoản")</span>
                            </button>
                          
                        </div>
                    </div>
                </div>

      
            </div>
        </div>
    </td>
</tr>
