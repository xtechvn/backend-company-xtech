@{
    Layout = null;
}
@using Entities.ViewModels

@model TenantViewModel
<form id="form-create-user">
    <div class="user-popup popup-width2 white-popup flex">
        <div class="up-file mb15">

           @*  <label class="choose">
                <input type="file" name="imagefile" onchange="_tenant.OnChangeImage()" />
                chọn ảnh
            </label> *@
        </div>
        <div class="form-default row">
            @if (Model == null || Model.TenantId == 0  )
            {
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="lbl">Họ tên <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" id="FullName" name="FullName" value="@Model.SurrogateName" placeholder="Nhập họ và tên" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Điện thoại</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" name="Phone" id="Phone" value="@Model.SurrogatePhone">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Địa chỉ</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" name="Address" id="Address" value="@Model.Address">
                        </div>
                    </div>

                </div>
                <div class="col-md-6">
                    
                    <div class="form-group">
                        <label class="lbl">Email <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" name="Email" id="Email" value="@Model.SurrogateEmail">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Trạng thái</label>
                        <div class="wrap_input">
                            <select class="form-control" name="Status" value="@Model.Status">
                                <option value="0">Kích hoạt</option>
                                <option value="1">Tạm ngưng</option>
                            </select>
                        </div>
                    </div>
                    @* <div class="form-group">
                        <label class="lbl">Ghi chú</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" asp-for="@Model.Note">
                        </div>
                    </div> *@
                    @*     <div class="form-group male">
                        <label class="lbl">Giới tính</label>
                        <label class="radio-inline"><input type="radio" asp-for="@Model.Gender" value="1">Nam</label>
                        <label class="radio-inline"><input type="radio" asp-for="@Model.Gender" value="0">Nữ</label>
                    </div> *@
                </div>
                <div class="col-md-12">
                    <div><h5>Thông tin đăng nhập</h5> </div>
                    <div class="form-group">
                        <label class="lbl">Tên đăng nhập <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" asp-for="@Model.UserName" placeholder="Nhập họ và tên" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Mật khẩu <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="password" class="form-control" asp-for="@Model.Password" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Gõ lại mật khẩu <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="password" class="form-control" name="RePassword">
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-6">
                    <input type="hidden" asp-for="@Model.TenantId" />
                    <div class="form-group">
                        <label class="lbl">Họ tên</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" id="FullName" name="FullName" value="@Model.SurrogateName" placeholder="Nhập họ và tên" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Tên đăng nhập <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" asp-for="@Model.UserName" disabled="disabled" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Email <sup class="red">*</sup></label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" id="Email" name="Email" value="@Model.SurrogateEmail" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Điện thoại</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" id="Phone" name="Phone" value="@Model.SurrogatePhone" />
                        </div>
                    </div>

                    @*     <div class="form-group">
                        <label class="lbl">Ngày sinh</label>
                        <div class="wrap_input">
                            <input id="datepicker" class="datepicker-input form-control" type="text" name="BirthDayPicker" value="@(Model.BirthDay == null ? "" : ((DateTime)Model.BirthDay).ToString("dd/MM/yyyy"))">
                        </div>
                    </div> *@
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="lbl">Địa chỉ</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" asp-for="@Model.Address" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="lbl">Trạng thái</label>
                        <div class="wrap_input">
                            <select class="form-control" asp-for="@Model.Status">
                                <option value="0">Kích hoạt</option>
                                <option value="1">Tạm ngưng</option>
                            </select>
                        </div>
                    </div>
                    @* <div class="form-group">
                        <label class="lbl">Ghi chú</label>
                        <div class="wrap_input">
                            <input type="text" class="form-control" asp-for="@Model.Note">
                        </div>
                    </div>
                    <div class="form-group male">
                        <label class="lbl">Giới tính</label>
                        <label class="radio-inline"><input type="radio" asp-for="@Model.Gender" value="1">Nam</label>
                        <label class="radio-inline"><input type="radio" asp-for="@Model.Gender" value="0">Nữ</label>
                    </div> *@

                </div>
            }
            <div class="form-group align-right col-12 mt20 block">
                <button type="button" class="btn btn-default red" onclick="_tenant.OnUpdateUser()"><i class="fa fa-floppy-o"></i>Lưu</button>
                <button type="button" class="btn btn-default cancel" data-dismiss="modal"><i class="fa fa-ban"></i>Bỏ qua</button>
            </div>
        </div>
    </div>
</form>
