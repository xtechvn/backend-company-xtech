@using Entities.ViewModels;
@using Ultilities.Constants
@using Utilities.Contants;
@{

    ViewData["Title"] = "Chi tiết quản lý đơn hàng";
    var client = (Entities.Models.Client)ViewBag.Client;
    var SalerId = ViewBag.SalerId;
    var SalerGroupId = ViewBag.SalerGroupId;
}
@model GenericViewModel<OrderViewModel>
@if (Model != null)
{
    <section class="main-container">
        <div class="container">
            <div class="row">
                <input id="order_Id" value="@ViewBag.OrderId" style="display:none" />
                <input id="Saler_Id" value="@ViewBag.SalerId" style="display:none" />
                <input id="Saler_GroupId" value="@ViewBag.SalerGroupId" style="display:none" />
                <input id="ProductService" value="@ViewBag.ProductService" style="display:none" />
                <div class="col-xl-9">

                    <div id="grid_data_ClientDetai">
                        @if (client != null)
                        {
                            <div class="border bg-white mb20">
                                <div class="flex space-between pd10">
                                    <div class="bold">Thông tin khách hàng</div>

                                </div>
                                <div class="line-bottom pb0 mb0"></div>
                                <div class="info-basic flex align-center pd10 mb10">
                                    <div class="ava">
                                        <span class="thumb_img thumb_5x5">
                                            @if (client.Avartar != null)
                                            {
                                                <img src="@client.Avartar">
                                            }
                                            else
                                            {
                                                <img src="/images/graphics/no-avt.png">
                                            }
                                        </span>
                                    </div>
                                    <div class="content">
                                        <div class="name">@(client.ClientName)</div>
                                        <div>@(client.Phone != null ? client.Phone : "... ") -  @(client.Email != null ? client.Email : " ...")</div>

                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="border bg-white mb20">
                                <div class="flex space-between pd10">
                                    <div class="bold">Thông tin khách hàng</div>

                                </div>
                                <div class="line-bottom pb0 mb0"></div>
                                <div class="info-basic flex align-center pd10 mb10">
                                    <div class="ava">
                                        <span class="thumb_img thumb_5x5">
                                            <img src="/images/graphics/user.jpeg">
                                        </span>
                                    </div>
                                    <div class="content">
                                        <div class="name">Khách chưa được tạo tài khoản</div>
                                    </div>
                                </div>
                            </div>
                        }


                        <div id="grid_data_Packages">
                            <partial name="_Skeleton" />
                        </div>

                        <div id="grid_data_ContractPay">
                            <partial name="_Skeleton" />
                        </div>

                        <div id="grid_data_BillVAT">
                            <partial name="_Skeleton" />
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-default cancel ml-1" onclick="history.back()">Quay lại</button>
                            <button type="button" class="btn text-white ml-1" style="background-color:#6610F2" onclick=""><i class="icofont-save"></i>Lưu thông tin</button>
                        </div>

                    </div>
                </div>
                <div class="col-xl-3" style="min-width:310px">

                    <div id="grid_data_SingleInformation">
                        <div class="border bg-white p-3 mb20">
                            <div class="flex space-between">
                                <h5 class="text-uppercase">Thông tin đơn hàng</h5>
                                @* <a class="edit" href=""><i class="icofont-ui-edit"></i><i class="icofont-save"></i></a>*@
                            </div>
                            <div class="flex">
                                @if (Model.ListData[0].StatusCode != null)
                                {
                                    @switch (Convert.ToInt32(Model.ListData[0].StatusCode))
                                    {
                                        case (int)(OrderStatus.New):
                                        case (int)(OrderStatus.Received_for_implementation):
                                            {
                                                <span class="status-oranger">@Model.ListData[0].Status </span>
                                            }
                                            break;
                                        case (int)(OrderStatus.Approved_by_accounting):
                                            {

                                                <div class="status-green">@Model.ListData[0].Status</div>

                                            }
                                            break;
                                        case (int)(OrderStatus.Completed):
                                        case (int)(OrderStatus.Approved_by_management):
                                            {
                                                <span class="status-green">@Model.ListData[0].Status </span>
                                            }
                                            break;
                                        case ((int)(OrderStatus.Canceled)):
                                        case ((int)(OrderStatus.Rejected_by_management)):
                                        case ((int)(OrderStatus.Rejected_by_accounting)):
                                        case ((int)(OrderStatus.Draft)):

                                            {
                                                <span class="status-red">@Model.ListData[0].Status</span>
                                            }
                                            break;
                                    }
                                }
                                <div style="width:3px"></div>
                                @if (Model.ListData[0].PaymentStatusName != null)
                                {
                                    @switch (Convert.ToInt32(Model.ListData[0].PaymentStatus))
                                    {
                                        case (int)(PaymentStatus.UNPAID):
                                            {
                                                <span class="status-oranger">@Model.ListData[0].PaymentStatusName </span>
                                            }
                                            break;
                                        case (int)(PaymentStatus.PAID):
                                            {
                                                <span class="status-green">@Model.ListData[0].PaymentStatusName </span>
                                            }
                                            break;
                                        case (int)(PaymentStatus.PAID_NOT_ENOUGH):
                                            {
                                                <span class="status-blue">@Model.ListData[0].PaymentStatusName </span>
                                            }
                                            break;

                                    }
                                }
                            </div>


                            <div class="flex justify-content-end w-100">
                                <ul class="w-100 my-3">
                                    <li class="flex mb-2">
                                        <div class="">Mã đơn hàng :</div>
                                        <div style="width:3px"></div>
                                        <h7 class="text-left" style="color:#056BD3;">@(Model.ListData[0].OrderNo)</h7>
                                    </li>
                                    <li>
                                        <div class="form-group">
                                            <label class="lbl">Nhãn đơn*</label>
                                            <div class="wrap_input">
                                                <textarea style="border-radius:2px" rows="3" class="form-control">@Model.ListData[0].Label</textarea>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="flex">
                                        <div class="">Ngày bắt đầu - Ngày kết thúc</div>
                                    </li>
                                    <li class="flex mb-2">
                                        <div class="" style="font-weight:450">
                                            @((Model.ListData[0].StartDate != DateTime.MinValue ? Model.ListData[0].StartDate.ToString("yyyy-MM-dd") : "Không") + " - " + (Model.ListData[0].EndDate != DateTime.MinValue ? Model.ListData[0].EndDate.ToString("yyyy-MM-dd") : "không"))
                                        </div>
                                    </li>

                                    <li class="flex mb-2">
                                        <div class="">Chi nhánh*</div>
                                    </li>
                                    <li class="flex mb-2"><input class="form-control " style="width:100%;border-radius:2px;background: #f0f0f0;" type="text" disabled value="@Model.ListData[0].Branch" /></li>
                                    <li>
                                        <div class="form-group">
                                            <label class="lbl">Ghi chú</label>
                                            <div class="wrap_input">
                                                <textarea rows="3" style="border-radius:2px" class="form-control">@Model.ListData[0].Note</textarea>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div id="grid_data_PersonInCharge">
                        <partial name="_Skeleton" />
                    </div>
                    <div id="grid_data_File">
                        <partial name="_Skeleton" />
                    </div>
                    <div id="grid_data_SystemInformation">
                        <div class="border bg-white mb20">
                            <div class="lb-form pd10">
                                Thông tin hệ thống
                            </div>
                            @if (Model.ListData[0].CreatedName != null)
                            {
                                <div class="pd10">
                                    <ul class="mb0">
                                        <li class="grid grid__2">
                                            <div>Ngày tạo</div>
                                            <div>: @Model.ListData[0].CreateTime.ToString("dd/MM/yyyy")</div>
                                        </li>
                                        <li class="grid grid__2">
                                            <div>Người tạo</div>
                                            <div>: @Model.ListData[0].CreatedName</div>
                                        </li>
                                        <li class="grid grid__2">
                                            <div>Ngày cập nhật</div>
                                            <div>: @(Model.ListData[0].UpdateLast != null ? Convert.ToDateTime(Model.ListData[0].UpdateLast).ToString("dd/MM/yyyy") : "N/A")</div>
                                        </li>
                                        <li class="grid grid__2">
                                            <div>Người cập nhật</div>
                                            <div>: @(Model.ListData[0].UpdateName != null ? Model.ListData[0].UpdateName : "N/A")</div>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <div class="pd10">
                                    N/A
                                </div>
                            }
                        </div>
                    </div>

                   @*  <div class="form-group align-right mt20 block pin-btn-bottom ">
                        <button type="button" class="btn btn-default cancel ml-1" onclick="history.back()">Quay lại</button>

                        <button type="button" class="btn btn-default ml-1" onclick="_orderDetail.ChangeOrderSaler(@ViewBag.OrderId,'@ViewBag.OrderNo')">Nhận xử lý đơn hàng</button>
                    </div> *@
                </div>
            </div>
        </div>
    </section>
}



<!--Back to top-->
<a href="javascript:;" id="to_top"><i class="ic ic-caret-up"></i></a>
<div class="mask-content"></div>

@section scripts {

    <script type="text/javascript" src="~/modules/orderCMSDetail.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/modules/order_detail.js"></script>
}