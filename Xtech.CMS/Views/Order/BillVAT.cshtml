@using Entities.ViewModels;
@using Entities.ViewModels.InvoiceRequest
@{
    Layout = null;
}
@model List<InvoiceRequestViewModel>
<style>
    .disabled_td
    {
        pointer-events: none;
    }
</style>
<div class="border bg-white mb20">
    <div class="p-3">
        <div class="d-flex justify-content-between">
            <h6 class="bold mb-2">Yêu cầu xuất hóa đơn</h6>
            @if(Model != null)
            {
                <button class="btn btn-add mb-2 text-white" onclick="_invoiceRequest.ShowForm('','@Model[0].ClientId','@Model[0].OrderId')" style="background:#0c8ce9"><i class="icofont-plus"></i>Thêm</button>
            }
            else
            {
                <button class="btn btn-add mb-2 text-white" onclick="_invoiceRequest.ShowForm()" style="background:#0c8ce9"><i class="icofont-plus"></i>Thêm</button>
            }
        </div>
        <div class="table-responsive table-gray">
            <table class="table table-nowrap">
                <thead>
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th>Mã hóa đơn</th>
                        <th>Nội dung</th>
                        <th>Số tiền</th>
                        <th>Trạng thái</th>
                        <th style="width: 250px;">Ngày gửi</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        var i = 0;
                        foreach (var item in Model)
                        {
                            i++;
                            <tr>
                                <td>@i</td>
                                <td>@item.OrderNo</td>
                                <td>@item.Note</td>
                                <td>@item.TotalPrice.ToString("N0")</td>
                                <td>@item.InvoiceRequestStatus</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td style="color:#0c8ce9;cursor:pointer" class="text-center show_form_invoice" onclick="_invoiceRequest.ShowForm('@item.Id','@item.ClientId','@item.OrderId')">Xem</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>